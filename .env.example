# =============================================================================
# Wishubest — Environment Variables Template
# =============================================================================
# Copy this file to `.env` (local dev) or set these in your Vercel project
# settings (Settings → Environment Variables) for production.
#
# DO NOT commit the real `.env` file — it contains secrets.
# =============================================================================

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (required for Vercel production).
# Local dev can use SQLite: "file:./dev.db" (but schema is now postgresql).
# Get a free Postgres DB from Vercel Postgres, Neon, Supabase, or Railway.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://user:password@host:5432/wishubest?schema=public"

# ─── App Config ─────────────────────────────────────────────────────────────
# Public URL of the deployed app (no trailing slash).
# Used for sitemap.xml, robots.txt, email links, canonical URLs, OG tags.
# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="https://wishubest.com"

# Public app name (shown in emails, meta tags, etc.)
NEXT_PUBLIC_APP_NAME="Wishubest"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Secret used to sign session cookies (HMAC). MUST be a long random string.
# Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
# Used for sending booking confirmations, password resets, notifications.
# For Vercel, use a transactional email service: Resend, SendGrid, Postmark,
# or Amazon SES. SMTP settings below work with most providers.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="Wishubest <noreply@wishubest.com>"

# ─── Payments (Stripe) ──────────────────────────────────────────────────────
# Stripe secret key for processing booking payments.
# Get from: https://dashboard.stripe.com/apikeys
# Test key: sk_test_... | Live key: sk_live_...
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# ─── AI Features ────────────────────────────────────────────────────────────
# Google Gemini API key for the AI Triage Bot (symptom checker).
# Get from: https://aistudio.google.com/apikey
# NOTE: The platform also supports z-ai-web-dev-sdk (no key needed) as fallback.
GOOGLE_GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Video Consultations (optional) ─────────────────────────────────────────
# Provider for video sessions: "whereby" | "zoom" | "daily"
VIDEO_PROVIDER="whereby"
WHEREBY_API_KEY=""
ZOOM_ACCOUNT_ID=""
DAILY_API_KEY=""

# ─── Translation API (optional) ─────────────────────────────────────────────
# Used for in-chat message translation. If not set, translations are skipped.
TRANSLATION_API_KEY=""
TRANSLATION_BASE_URL=""
TRANSLATION_TOKEN=""

# ─── Google OAuth (optional) ────────────────────────────────────────────────
# For "Sign in with Google" button. If not set, only email/password auth works.
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""

# ─── VPS Docker Deployment ───────────────────────────────────────────────────
# When deploying with docker-compose on a VPS, the DATABASE_URL must use
# the internal Docker network hostname 'db' (not localhost):
#   postgresql://postgres:PASSWORD@db:5432/wishubest?schema=public
#
# The docker-compose.yml file automatically constructs this URL from the
# individual POSTGRES_* vars below. You only need to set these:
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="wishubest"

# Supabase Storage (for file uploads — KYC, media, medical records)
# Create buckets: kyc-documents, kyc-videos, media-assets, medical-records
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare Turnstile (anti-bot for auth forms)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY="your-site-key"
CF_TURNSTILE_SECRET_KEY="your-secret-key"
